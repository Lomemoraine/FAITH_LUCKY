# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Moderator Allowlist (comma-separated lowercase emails)
# Staff must sign in using a confirmed Supabase Auth account (password or magic link).
# Add /auth/callback to the Supabase Auth redirect URL allowlist.
MODERATOR_EMAILS=moderator@talkfreelylifestyle.org,admin@talkfreelylifestyle.org

# Security & Rate Limiting
RATE_LIMIT_HMAC_SECRET=your-random-rate-limit-hmac-secret
STAGING_ACCESS_PASSWORD=safespace-staging-preview-pass

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# httpSMS Gateway Configuration (Self-Hosted Docker or Cloud)
# If using self-hosted docker, set to http://localhost:8080 or your VPS URL.
# If using managed cloud, default is https://api.httpsms.com
HTTPSMS_API_URL=https://api.httpsms.com
HTTPSMS_API_KEY=your-httpsms-api-key
HTTPSMS_FROM_NUMBER=+254712345678
DUTY_COUNSELOR_PHONE=+254700000000

# AI Semantic Crisis Detection (OpenRouter / Gemini)
# Optional: If provided, AI will semantically triage Sheng, Swahili, and subtle cries for help.
# If omitted, system seamlessly runs on the high-speed regex dictionary engine.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-3-flash-preview
GEMINI_API_KEY=your-gemini-api-key

# Daraja M-Pesa: server-only configuration, never NEXT_PUBLIC_ variables.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PARTY_B=174379
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PASSKEY=your-daraja-simulator-passkey
# Must host /api/mpesa/callback with the same database and configuration.
MPESA_CALLBACK_BASE_URL=https://your-deployed-app.example
# At least 32 random characters. Scheduler calls GET /api/mpesa/reconcile
# with Authorization: Bearer <CRON_SECRET>. Not required for browser polling.
CRON_SECRET=
